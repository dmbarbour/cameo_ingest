# Copy to .env (gitignored) and fill in. cameo-ingest does not read this file itself yet;
# load it into your shell first:  set -a; . ./.env; set +a

# Any OpenAI-compatible endpoint (e.g. vLLM, Ollama, or a hosted provider).
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=http://localhost:8000/v1

# LLM enrichment stays off unless a text model is named here or with --text-model.
CAMEO_INGEST_TEXT_MODEL=your-model-name
# Optional; defaults to the text model.
# CAMEO_INGEST_VISION_MODEL=your-vision-model-name
# Optional; defaults shown.
# CAMEO_INGEST_LLM_TIMEOUT=120
# CAMEO_INGEST_LLM_MAX_CALLS=500
