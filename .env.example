# Copy to .env (gitignored), fill in, and pass it with:  cameo-ingest --env .env ...
# Variables already set in your environment take precedence over this file.

# Any OpenAI-compatible endpoint (e.g. vLLM, Ollama, or a hosted provider).
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=http://localhost:8000/v1

# The model for summaries; CAMEO_INGEST_TEXT_MODEL takes precedence if both are set.
OPENAI_MODEL=your-model-name
# Optional; defaults to the text model.
# CAMEO_INGEST_VISION_MODEL=your-vision-model-name
# Optional; defaults shown (no call limit unless set).
# CAMEO_INGEST_LLM_TIMEOUT=120
# CAMEO_INGEST_LLM_RETRIES=2
# CAMEO_INGEST_LLM_MAX_CALLS=
