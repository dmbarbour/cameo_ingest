# cameo-ingest reads only OPENAI_BASE_URL and OPENAI_API_KEY from the environment (export them);
# the models and every other setting are the tree's: `cameo-ingest config`.
# Developer scripts and `pytest -m llm` also read this file, copied to .env (gitignored);
# variables already set in your environment take precedence over it.

# Any OpenAI-compatible endpoint (e.g. vLLM, Ollama, or a hosted provider); unset for OpenAI.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=http://localhost:8000/v1

# The model the live tests and the fixture recorder use (not read by cameo-ingest).
OPENAI_MODEL=your-model-name
